{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x",
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "FIREBASE_ADMIN_SDK_JSON": "@firebase_admin_sdk_json",
    "ESCROW_API_KEY": "@escrow_api_key",
    "ESCROW_API_SECRET": "@escrow_api_secret"
  }
}
